{
  "ConnectionStrings": {
    "DocumentAssistant": "Host=localhost;Port=5432;Database=documentassistant;Username=appuser"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Embeddings": {
    "Provider": "Ollama",
    "Model": "nomic-embed-text",
    "CostPerMillionTokens": 0,
    "DocumentPrefix": "search_document: ",
    "QueryPrefix": "search_query: "
  }
}
