{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Embeddings": {
    "Provider": "OpenAI",
    "Model": "text-embedding-3-small",
    "OllamaEndpoint": "http://localhost:11434",
    "BatchSize": 64,
    "CostPerMillionTokens": 0.02
  },
  "Chunking": {
    "MaxChunkSize": 1500,
    "ChunkOverlap": 200
  }
}
